# Copy to .env on your server; do not commit. Generate real values before launch.
APP_URL=https://clock.example.com
APP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BACKUP_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
DB_PATH=/data/shifttap.sqlite
BACKUP_DIR=/backups
COOKIE_SECURE=true
# Only enable behind the supplied Caddy proxy. Do not expose app port 8000.
TRUST_PROXY=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=ShiftTap <attendance@example.com>
